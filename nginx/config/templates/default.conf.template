server {
  listen ${HTTP_PORT} default_server;
  listen [::]:$HTTP_PORT default_server;

  root /var/www;
  index index.html;

  location / {
      try_files $uri $uri/ =404;
    }
}

server {
  listen ${HTTPS_PORT} ssl default_server;
  listen [::]:$HTTPS_PORT ssl default_server;

  root /var/www;
  index index.html;

  ssl_certificate /etc/nginx/ssl/selfsigned-cert.pem;
  ssl_certificate_key /etc/nginx/ssl/selfsigned-key.pem;

  location / {
    try_files $uri $uri/ =404;
  }
}
